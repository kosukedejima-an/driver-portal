# 設定項目の一覧です（パソコンで動かすときに使います）。
# このファイルをコピーして .env.local という名前にし、値を入れてください。
# .env.local は Git に含まれません（パスワード等を公開しないため）。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 管理者がアカウントを作る・パスワードを再設定するときだけ使う、強い権限のキー。
# 名前に NEXT_PUBLIC_ を付けないこと（付けるとスマホ側に見えてしまいます）。
SUPABASE_SERVICE_ROLE_KEY=

# プッシュ通知用の鍵（管理者メニュー「テスト用」→「通知用の鍵を作る」で作れます）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 事故報告書の画像・PDFを AI（Claude）で読み取るための鍵（Anthropic のコンソールで作る）
# 名前に NEXT_PUBLIC_ を付けないこと。Vercel では「Secret」として登録する
ANTHROPIC_API_KEY=
